# Ссылка на поиск вакансий
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# OpenAI-compatible API
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# Таймаут запроса к ИИ целиком (reasoning-модели могут думать дольше минуты)
HH_AI_TIMEOUT=120s

# Усилие рассуждения: minimal, low, medium, high, max (пусто — не отправлять параметр)
HH_AI_REASONING_EFFORT=medium

# Всегда генерировать сопроводительное письмо
HH_FORCE_LETTER=false

# Интервал между запросами к hh.ru
HH_REQUEST_INTERVAL=10s

# Имитируемый отпечаток TLS/HTTP2 (chrome_152, firefox_132, ... , off)
HH_BROWSER_PROFILE=chrome_152

# Платформа в заголовках браузера (macos, windows) — должна совпадать с той,
# откуда получены cookies, иначе hh.ru видит смену платформы в рамках сессии
HH_BROWSER_PLATFORM=macos

# Случайные паузы и длинные перерывы между запросами к hh.ru
HH_HUMAN_PACING=true
